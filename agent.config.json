{
  "version": "0.1.0",
  "project_root": ".",
  "max_retries": 3,
  "state_dir": ".agent",
  "verify": {
    "rules": null,
    "type": null,
    "timeout_sec": 3600
  },
  "diff": {
    "max_chars": 12000,
    "context_lines": 3
  },
  "design": {
    "enabled": false,
    "max_chars": 20000,
    "tool": null,
    "mcp": {
      "command": "npx",
      "args": ["-y", "@mastergo/vibe-mcp"],
      "env_keys": ["MASTERGO_TOKEN"]
    }
  },
  "spec": {
    "backend": "claude_cli",
    "model": null,
    "timeout_sec": 600
  },
  "code": {
    "backend": "claude_cli",
    "model": null,
    "max_turns": 60,
    "permission_mode": "acceptEdits",
    "timeout_sec": 1800
  },
  "review": {
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-chat",
    "api_key_env": "DEEPSEEK_API_KEY",
    "timeout_sec": 180
  },
  "fix": {
    "backend": "dsh_cli",
    "command": ["dsh", "headless", "{prompt}"],
    "timeout_sec": 1800
  },
  "notify": {
    "dedup_hours": 24
  }
}
