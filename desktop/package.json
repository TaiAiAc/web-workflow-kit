{
  "name": "web-workflow-kit-desktop",
  "productName": "前端交付流水线",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "description": "web-workflow-kit 桌面端：本地前端交付流水线控制台",
  "author": "quiteer",
  "main": "dist/resource/electron.cjs",
  "scripts": {
    "dev": "pnpm core && electronup",
    "build": "pnpm core && electronup build",
    "build:dir": "pnpm core && electronup build --dir",
    "build:win": "pnpm core && electronup build --win x64",
    "build:mac": "pnpm core && electronup build --mac",
    "build:linux": "pnpm core && electronup build --linux",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "core": "pnpm --dir ../core install --frozen-lockfile && pnpm --dir ../core build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.6.1",
    "@types/node": "^22.20.5",
    "electron": "^45.0.0",
    "electronup": "^0.3.1",
    "eslint": "^10.0.2",
    "eslint-plugin-format": "^2.0.1",
    "typescript": "~5.9.3"
  }
}
