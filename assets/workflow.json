{
  "version": 2,
  "roles": {
    "product": { "agent": "claude", "model": null, "effort": null },
    "tech": { "agent": "codex", "model": null, "effort": null },
    "dev": { "agent": "claude", "model": null, "effort": null },
    "vision": { "agent": "codex", "model": null, "effort": null },
    "arbiter": { "agent": "dsh", "model": null, "effort": null }
  },
  "vision": { "backend": "codex_acp", "model": null, "timeout_sec": 300, "cli_command": ["codex"] },
  "stages": {
    "discovery": { "order": 10, "role": "product" },
    "tech-design": { "order": 20, "role": "tech" },
    "doc-review": { "order": 30, "role": "product", "max_rounds": 2, "on_exceed": "arbiter" },
    "implement": { "order": 40, "role": "dev" },
    "impl-review": { "order": 45, "role": "tech", "max_rounds": 2 },
    "gate": { "order": 50, "kind": "verify", "install_command": "auto" },
    "acceptance": { "order": 60, "role": "product", "max_rounds": 2 }
  },
  "input_modes": {
    "mastergo": { "intake": "mastergo_mcp" },
    "image": { "intake": "vision" },
    "text": { "intake": "none" }
  },
  "git": { "branch_prefix": "wwk/", "merge_method": "squash", "keep_failed_branches": 3 },
  "documents": { "repo_dir": "docs/wwk", "schema_version": 1 },
  "limits": { "max_retries": 3, "max_doc_lint_failures": 3, "token_budget": 0, "time_budget_sec": 0 }
}
